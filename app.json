{
  "expo": {
    "name": "Neural Audio",
    "slug": "neural-audio",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "neuralaudio",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTableT": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.neuralaudio.app"
    },
    "android": {
      "package": "com.neuralaudio.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "pwaHostname": "neural-audio.app"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
